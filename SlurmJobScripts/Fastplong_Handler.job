#!/bin/bash
set -euo pipefail

echo "=== Fastplong_Handler.job started at $(date) ==="
echo "CONFIG: $1"
echo "SEQUENCE_HANDLING: $2"
echo "Hostname: $(hostname)"
echo "Working directory: $(pwd)"
echo "Job ID: ${SLURM_JOB_ID:-LOCAL}"

echo "Loading modules (if any)..."
# module load fastplong || true

CONFIG="$1"
SEQUENCE_HANDLING="$2"

# Source config and handler
if [[ ! -f "${CONFIG}" ]]; then
    echo "ERROR: Config not found: ${CONFIG}" >&2
    exit 1
fi
if [[ ! -f "${SEQUENCE_HANDLING}/Handlers/Fastplong.sh" ]]; then
    echo "ERROR: Fastplong handler not found: ${SEQUENCE_HANDLING}/Handlers/Fastplong.sh" >&2
    exit 1
fi

echo "Sourcing config and handler..."
source "${CONFIG}"
source "${SEQUENCE_HANDLING}/Handlers/Fastplong.sh"

echo "Variables:"
echo "FASTP_SAMPLES = ${FASTP_SAMPLES:-}"
echo "FASTP_OUTDIR = ${FASTP_OUTDIR:-}"
echo "FASTP_PROJECT_NAME = ${FASTP_PROJECT_NAME:-}"
echo "ADAPTERS = ${ADAPTERS:-}"
echo "CONFIG_FASTP = ${CONFIG_FASTP:-${CONFIG}}"
echo "SKIP_ADAPTER_TRIM = ${SKIP_ADAPTER_TRIM:-}"
echo "FORCE_ADAPTER_TRIM = ${FORCE_ADAPTER_TRIM:-}"

echo "Running Fastplong handler..."
Fastplong "${FASTP_SAMPLES}" "${OUT_DIR}/Fastplong" "${FASTP_PROJECT_NAME}" "${ADAPTERS}" "${CONFIG_FASTP:-${CONFIG}}"

echo "=== Fastplong_Handler.job completed at $(date) ==="
